// Vinamaz — Phase 1 schema
//
// Conventions
//  - Internal primary keys are CUIDs. Public identifiers (e.g. VNZ-2026-000001)
//    are separate columns added in the models that need them (Phase 2).
//  - Every table has createdAt; mutable tables have updatedAt.
//  - Deletion: owned child rows cascade from their parent; references to users
//    from audit/history rows are SET NULL so history survives user removal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & authorization
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  STAFF
  ADMIN
  SUPER_ADMIN
}

/// One account table for clients and staff. Authorization = role defaults
/// (see src/lib/auth/permissions.ts) + per-user extra grants in `permissions`.
model User {
  id              String    @id @default(cuid())
  /// Always stored lower-cased and trimmed.
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String
  role            Role      @default(CLIENT)
  /// Additional permission keys granted to this user on top of the role defaults
  /// (primarily used for STAFF). Validated against the permission catalogue in code.
  permissions     String[]  @default([])
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clientProfile ClientProfile?
  auditLogs     AuditLog[]
  applications  VisaApplication[]

  @@index([role, isActive])
  @@index([createdAt])
}

/// Personal details that belong to the client (not to a single application).
/// Application-specific answers live on the application (Phase 2).
model ClientProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  whatsapp           String?
  dateOfBirth        DateTime? @db.Date
  nationality        String?
  countryOfResidence String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Travel packages (fully database-driven; no package content lives in code)
// ---------------------------------------------------------------------------

enum PackageStatus {
  /// Being configured; never shown publicly.
  DRAFT
  /// Visible on the public site and open for applications.
  ACTIVE
  /// Previously active, hidden from the public site.
  INACTIVE
}

model TravelPackage {
  id   String @id @default(cuid())
  slug String @unique

  name     String
  country  String
  /// Free-form so new kinds of packages need no code change (e.g. "Visa assistance").
  category String?

  shortDescription String?
  description      String?

  /// Public marketing image (not sensitive). Applicant documents never use this field.
  imageUrl String?
  imageAlt String?

  /// All money fields are optional: unknown values stay null and are never displayed.
  price          Decimal? @db.Decimal(12, 2)
  applicationFee Decimal? @db.Decimal(12, 2)
  serviceFee     Decimal? @db.Decimal(12, 2)
  currency       String   @default("NGN") @db.VarChar(3)

  processingEstimate String?
  inclusions         String[] @default([])
  exclusions         String[] @default([])
  importantInfo      String?
  terms              String?
  /// [{ "question": string, "answer": string }] — validated with Zod on write.
  faqs               Json     @default("[]")

  status       PackageStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements         PackageRequirement[]
  documentRequirements PackageDocumentRequirement[]
  questions            PackageQuestion[]
  applications         VisaApplication[]

  @@index([status, displayOrder])
  @@index([status, isFeatured])
  @@index([country])
}

enum RequirementType {
  ELIGIBILITY
  REQUIREMENT
}

model PackageRequirement {
  id          String          @id @default(cuid())
  packageId   String
  type        RequirementType @default(REQUIREMENT)
  title       String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  package TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, type, sortOrder])
}

/// Documents a client is asked to upload for this package (upload itself: Phase 2).
model PackageDocumentRequirement {
  id              String   @id @default(cuid())
  packageId       String
  /// Stable machine key within the package, e.g. "passport_bio_page".
  key             String
  name            String
  description     String?
  isRequired      Boolean  @default(true)
  acceptedFormats String[] @default(["pdf", "jpg", "png"])
  maxSizeMb       Int      @default(10)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  package TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, key])
  @@index([packageId, sortOrder])
}

enum QuestionType {
  TEXT
  TEXTAREA
  DATE
  NUMBER
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  COUNTRY
  PHONE
  EMAIL
  FILE
}

/// Package-specific application questions (answers: Phase 2).
model PackageQuestion {
  id         String       @id @default(cuid())
  packageId  String
  /// Stable machine key within the package; answers reference it.
  key        String
  label      String
  helpText   String?
  type       QuestionType @default(TEXT)
  isRequired Boolean      @default(false)
  /// Wizard section this question is shown in, e.g. "Employment / Education".
  section    String?
  sortOrder  Int          @default(0)
  /// Conditional display: { "questionKey": string, "operator": "equals"|"notEquals"|"in", "value": string|string[] }
  condition  Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  package TravelPackage           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  options PackageQuestionOption[]

  @@unique([packageId, key])
  @@index([packageId, sortOrder])
}

model PackageQuestionOption {
  id         String   @id @default(cuid())
  questionId String
  value      String
  label      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  question PackageQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, value])
  @@index([questionId, sortOrder])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

/// Per-year counter backing public application numbers (VNZ-YYYY-NNNNNN).
/// Incremented with a single atomic INSERT ... ON CONFLICT DO UPDATE ... RETURNING
/// statement, so concurrent transactions can never receive the same value.
model ApplicationCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Important administrative / security events. Not for UI noise.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Applications (Phase 2)
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  APPLICATION_SUBMITTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  DOCUMENTS_UNDER_REVIEW
  PROCESSING
  ADDITIONAL_INFORMATION_REQUIRED
  SUBMITTED_TO_AUTHORITY
  DECISION_PENDING
  APPROVED
  REFUSED
  COMPLETED
  CANCELLED
}

/// A client's application for one package. `applicationNumber` is the public, human-friendly
/// identifier (VNZ-2026-000001); `id` stays internal. Every query for client-owned data must
/// be scoped by `clientId` (see src/lib/services/applications.ts).
///
/// Extra DB constraints (raw SQL in the migration, not expressible in Prisma):
///  - at most one DRAFT per (clientId, packageId)
model VisaApplication {
  id                String            @id @default(cuid())
  applicationNumber String            @unique
  clientId          String
  packageId         String
  /// Snapshots so the record stays meaningful if the package is later renamed.
  packageName       String
  packageCountry    String
  status            ApplicationStatus @default(DRAFT)
  /// Core applicant details for this application (name, DOB, nationality, ...). Validated with Zod.
  applicant         Json              @default("{}")
  /// Wizard step the client should resume at.
  currentStep       String?
  /// Form-completion progress (0-100), recomputed whenever answers/documents change.
  /// NOT the processing status (that is `status`).
  progressPercent   Int               @default(0)
  lastSavedAt       DateTime          @default(now())
  submittedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client  User          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  package TravelPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  answers       ApplicationAnswer[]
  documents     ApplicationDocument[]
  statusHistory ApplicationStatusHistory[]

  @@index([clientId, status])
  @@index([clientId, updatedAt])
  @@index([packageId, status])
  @@index([status, updatedAt])
  @@index([createdAt])
}

/// Answers are keyed by the package question's stable `key` (not an FK) so that editing a
/// package's questions can never delete or orphan a client's submitted data.
model ApplicationAnswer {
  id            String   @id @default(cuid())
  applicationId String
  questionKey   String
  /// Label at the time of answering, for admin display if the question is later reworded.
  label         String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionKey])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  createdAt     DateTime           @default(now())

  application VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REPLACEMENT_REQUIRED
}

/// An uploaded applicant document. The file itself lives in PRIVATE object storage under
/// `storageKey`; there is no public URL. Replacements create a new row (`replacesId` -> old
/// row) and flip the old row's `isCurrent` to false, so history is preserved.
///
/// Extra DB constraint (raw SQL): at most one current row per (applicationId, requirementKey).
model ApplicationDocument {
  id               String         @id @default(cuid())
  applicationId    String
  /// Key of the package document requirement (or FILE question) this satisfies.
  requirementKey   String
  name             String
  storageKey       String         @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus @default(UPLOADED)
  rejectionReason  String?
  isCurrent        Boolean        @default(true)
  replacesId       String?
  uploadedById     String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())

  application VisaApplication       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  replaces    ApplicationDocument?  @relation("DocumentReplacement", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy  ApplicationDocument[] @relation("DocumentReplacement")

  @@index([applicationId, requirementKey, isCurrent])
  @@index([status, createdAt])
}

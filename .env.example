# --- Database (Neon in production) ---
# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://user:password@localhost:5432/vinamaz"
# Direct (non-pooled) connection string, used by `prisma migrate`. Optional locally.
DIRECT_URL=""

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Vercel sets this automatically; set to true when self-hosting behind a trusted proxy / running `next start` locally
AUTH_TRUST_HOST=""
# Public site URL (used for links in emails, Paystack callbacks later)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage: ONE private Vercel Blob store (documents + package images). Leave empty in local development. ---
BLOB_READ_WRITE_TOKEN=""
# Optional override; takes precedence over BLOB_READ_WRITE_TOKEN for storage.
PRIVATE_BLOB_READ_WRITE_TOKEN=""

# --- Payments (each gateway is offered only when its keys are set AND it is switched on in Admin -> Settings) ---
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
# The "secret hash" you choose in the Flutterwave dashboard (Settings -> Webhooks); required to accept its webhooks.
FLUTTERWAVE_SECRET_HASH=""
KORAPAY_SECRET_KEY=""
# Optional: point a gateway at a sandbox/mock server instead of the live API (leave empty in production).
PAYSTACK_API_BASE=""
FLUTTERWAVE_API_BASE=""
KORAPAY_API_BASE=""

# --- Email (password reset, invitations, payment receipts) ---
RESEND_API_KEY=""
EMAIL_FROM="Vinamaz <no-reply@example.com>"

# --- Seed: optional initial super admin (never committed; set only when seeding) ---
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
